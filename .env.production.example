# Production environment for docker-compose.yml + docker-compose.prod.yml.
# Copy to .env.production on the server (chmod 600, owned by the deploy user). NEVER commit it.
# Generate the secrets with: infrastructure/scripts/generate-secrets.sh
# Compose refuses to start if any value marked REQUIRED is empty.

# --- Site ---
DOMAIN=app.example.com                 # REQUIRED. DNS A/AAAA record must point at the server.
LETSENCRYPT_EMAIL=ops@example.com      # REQUIRED for init-letsencrypt.sh (expiry notices)
TZ=UTC

# --- Images ---
IMAGE_PREFIX=leadex
IMAGE_TAG=latest                       # deploy.sh sets this to the deployed git SHA
API_WORKERS=2                          # uvicorn workers (~1 per vCPU available to the api container)

# --- Core secrets (REQUIRED) ---
JWT_SECRET=                            # >= 32 chars
ENCRYPTION_KEY=                        # Fernet key (urlsafe base64 of 32 bytes). Losing it = losing encrypted data. Back it up offline.
POSTGRES_USER=leadex                   # schema owner (migrations, backups)
POSTGRES_PASSWORD=
POSTGRES_DB=leadex
APP_DB_PASSWORD=                       # restricted runtime role leadex_app (RLS enforced). Must not be 'leadex_app'.
REDIS_PASSWORD=
QDRANT_API_KEY=
S3_ACCESS_KEY=                         # must match the identity in SEAWEEDFS_S3_CONFIG
S3_SECRET_KEY=
SEAWEEDFS_S3_CONFIG=/etc/leadex/s3.json   # host path, outside the repo, chmod 600

# --- Backups ---
BACKUP_HOST_DIR=./backups              # host dir for dumps; ideally a separate disk/volume
BACKUP_SCHEDULE=0 2 * * *              # crontab syntax, container TZ
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=                      # empty = local only (NOT recommended: keep an off-server copy)
BACKUP_S3_ENDPOINT=                    # e.g. https://s3.eu-central-1.amazonaws.com, https://<acct>.r2.cloudflarestorage.com
BACKUP_S3_PREFIX=leadex
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=                  # write-only/append-only credentials if the provider supports it
BACKUP_S3_SECRET_KEY=

# --- Monitoring (only with --profile monitoring) ---
GRAFANA_ADMIN_PASSWORD=

# --- AI ---
OLLAMA_BASE_URL=http://ollama:11434    # when started with --profile ai, or an external endpoint

# --- Public URLs (REQUIRED) ---
CORS_ORIGINS=https://app.example.com           # the web app origin(s), comma separated; never "*"
WEB_APP_URL=https://app.example.com            # links in emails (password reset, invites)
PUBLIC_API_URL=https://api.example.com
PUBLIC_WEBHOOK_BASE_URL=https://api.example.com   # Twilio/Stripe/Razorpay call back here

# --- Email (REQUIRED for password reset / invites) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=no-reply@example.com

# --- Voice calls (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                            # E.164, e.g. +91XXXXXXXXXX
TWILIO_ESCALATION_NUMBER=                      # optional: human transfer
TWILIO_VOICE_EN_IN=                            # optional voice override, default female Polly.Aditi
TWILIO_VOICE_HI_IN=
FAST_LLM_BASE_URL=                             # REQUIRED for live calls, e.g. https://api.groq.com/openai/v1
FAST_LLM_API_KEY=
FAST_LLM_MODEL=                                # e.g. llama-3.1-8b-instant
VOICE_KILL_SWITCH=false                        # true stops ALL calls immediately

# --- Compliance ---
DNC_ENFORCE=true                               # block calls until the national DNC registry was checked
DNC_API_URL=                                   # optional registry API; otherwise import files in Compliance > DNC
DNC_API_KEY=
DNC_MAX_AGE_DAYS=31

# --- Discovery ---
GOOGLE_PLACES_API_KEY=
DISCOVERY_DAILY_REQUEST_BUDGET=

# --- WhatsApp Business Cloud ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                         # endpoint: /api/v1/billing/webhooks/stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                       # endpoint: /api/v1/billing/webhooks/razorpay

# --- Security & monitoring ---
CLAMAV_HOST=clamav                             # uploads are refused in production without a scanner
METRICS_TOKEN=                                 # Bearer token for /metrics (Prometheus)
SENTRY_DSN=                                    # optional (self-hosted GlitchTip is free)

# Full descriptions, sources and costs: docs/GO_LIVE_CHECKLIST.md
