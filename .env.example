# Copy to .env and fill in. NEVER commit .env.
APP_ENV=local                      # local | staging | production. Outbound integrations are simulated unless production.

# --- Core ---
JWT_SECRET=                        # required; generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=                    # Fernet key for secrets at rest; REQUIRED in production (startup fails without it).
                                   # generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
                                   # empty outside production => key derived from JWT_SECRET (legacy values stay readable)
PUBLIC_API_URL=http://localhost:8010   # public base URL of the API (webhook/tracking links)
WEB_APP_URL=http://localhost:3010      # public base URL of the web app (links in emails)
CELERY_ENABLED=false               # true => background jobs run on Celery workers (needs REDIS_URL)
POSTGRES_USER=leadex
POSTGRES_PASSWORD=leadex
POSTGRES_DB=leadex
API_PORT=8010                     # host ports (8000/3000 are often taken on dev machines)
WEB_PORT=3010
CORS_ORIGINS=http://localhost:3010
NEXT_PUBLIC_API_URL=http://localhost:8010

# For running the API/tests on the host against the dockerised DB:
APP_DB_PASSWORD=leadex_app        # password for the restricted runtime role; MUST be changed outside local
DATABASE_URL=postgresql+psycopg://leadex_app:leadex_app@localhost:5433/leadex
MIGRATION_DATABASE_URL=postgresql+psycopg://leadex:leadex@localhost:5433/leadex
REDIS_URL=redis://localhost:6379/0

# --- Storage / AI (Phase 3-4) ---
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=leadexs3
S3_SECRET_KEY=leadexs3-local-secret
QDRANT_API_KEY=
QDRANT_URL=                        # e.g. http://localhost:6333 ; empty => keyword-only knowledge retrieval
OLLAMA_BASE_URL=http://host.docker.internal:11434   # canonical (legacy OLLAMA_URL still accepted as fallback)
OLLAMA_MODEL=llama3.1              # model for workflow/email/website copy polish
OLLAMA_CHAT_MODEL=llama3.1:8b      # model for AI agents
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_HTTP_TIMEOUT_S=30

# --- Discovery (Phase 3) ---
GOOGLE_PLACES_API_KEY=             # empty => Places adapter reports not_configured; simulated data is labelled
DISCOVERY_DAILY_REQUEST_BUDGET=100 # max billable provider requests per organization per UTC day
GOOGLE_PLACES_RETENTION_DAYS=30    # provider fields are purged after this many days (Google ToS)
GOOGLE_PLACES_UNIT_COST=0.035      # USD per Places request; used for billing usage cost / budget hard stop
DISCOVERY_HTTP_TIMEOUT=10          # seconds
WEBSITE_AUDIT_MAX_RETRIES=2        # capped at 2

# --- Communication (Phase 7) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=                         # canonical (legacy SMTP_USERNAME still accepted as fallback)
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=                          # sender address for password reset / invite emails
EMAIL_WEBHOOK_SECRET=              # shared secret for inbound email provider webhooks (bounces/replies)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=                     # verifies X-Hub-Signature-256 on WhatsApp webhooks
WA_VERIFY_TOKEN=                   # token echoed during WhatsApp webhook verification

# --- Voice (Phase 5) ---
VOICE_KILL_SWITCH=false            # true => all calls are blocked globally
# Twilio voice (docs/TELEPHONY_SETUP.md). Per-org credentials (Integrations -> twilio) take precedence.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                # E.164, e.g. +15005550006 (your Twilio number)
TWILIO_ESCALATION_NUMBER=          # optional: callers asking for a human are <Dial>ed here
TWILIO_MACHINE_DETECTION=false
PUBLIC_WEBHOOK_BASE_URL=           # https tunnel to the API, e.g. https://xyz.trycloudflare.com ; empty => no real calls
ALLOW_TEST_CALLS=false             # non-production: true => really dial numbers on TEST_CALL_ALLOWLIST only
TEST_CALL_ALLOWLIST=               # comma-separated E.164 numbers, e.g. +919876543210

# --- Billing (Phase 10) ---
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_WEBHOOK_SECRET=              # Stripe dashboard > Webhooks; endpoint: <PUBLIC_API_URL>/api/v1/billing/webhooks/stripe
RAZORPAY_WEBHOOK_SECRET=            # Razorpay dashboard > Webhooks; endpoint: <PUBLIC_API_URL>/api/v1/billing/webhooks/razorpay

# ---- Live voice calls: fast AI replies (optional) ----
# A phone call needs replies in ~1-2 s; CPU-only Ollama takes ~30 s. Any OpenAI-compatible endpoint works.
# Free option: Groq free tier (rate-limited) -> https://console.groq.com/keys
FAST_LLM_BASE_URL=                  # e.g. https://api.groq.com/openai/v1
FAST_LLM_API_KEY=
FAST_LLM_MODEL=                     # e.g. llama-3.1-8b-instant
# Twilio voices (female Indian voice by default for Indian calls). Neural voices sound more natural but may cost extra.
TWILIO_VOICE_EN_IN=                 # default Polly.Aditi; e.g. Polly.Kajal-Neural
TWILIO_VOICE_HI_IN=                 # default Polly.Aditi; e.g. Polly.Kajal-Neural

# ---- Upload virus scanning (free, self-hosted ClamAV) ----
CLAMAV_HOST=                        # "clamav" when running: docker compose --profile scan up -d
CLAMAV_REQUIRED=                    # default: required in production (uploads refused without a scanner)

# ---- National do-not-call registries (TRAI NCPR, US DNC, UK TPS, CA DNCL, AU DNCR) ----
# Import your registry scrub file in Compliance > DNC registry, or point DNC_API_URL at a registry API.
DNC_ENFORCE=                        # default: on in production (calls blocked until the registry was checked)
DNC_API_URL=                        # optional; GET ?country=IN&phone=+91... -> {"listed": true|false}
DNC_API_KEY=
DNC_MAX_AGE_DAYS=31                 # an imported registry file older than this counts as stale

# ---- Monitoring ----
METRICS_TOKEN=                      # required in production to expose /metrics (Bearer token for Prometheus)
SENTRY_DSN=                         # optional error tracking (self-hosted GlitchTip is free)

CLAMAV_PORT=3310
TWILIO_VOICE_DEFAULT=               # fallback voice for languages without a default
