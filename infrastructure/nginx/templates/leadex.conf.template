# Rendered by the nginx image entrypoint: only ${DOMAIN} is substituted (nginx's own $vars are left intact).

# Port 80: ACME challenges + redirect everything else to HTTPS.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location = /nginx-health { access_log off; add_header Content-Type text/plain; return 200 "ok\n"; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/security-headers.conf;

    limit_conn perip 50;

    location /api/v1/auth {
        limit_req zone=auth burst=5 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://leadex_api;
    }

    location /api {
        limit_req zone=api burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://leadex_api;
    }

    # Websockets (API realtime / voice). Long read timeout for idle sockets.
    location /ws {
        include /etc/nginx/snippets/proxy.conf;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://leadex_api;
    }

    location /health {
        access_log off;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://leadex_api;
    }

    # Interactive API docs are not exposed publicly in production.
    location ~ ^/(docs|redoc|openapi\.json) { return 404; }

    # Grafana (only when started with --profile monitoring). Protected by Grafana's own login.
    location /grafana/ {
        limit_req zone=auth burst=20 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        set $grafana_upstream http://grafana:3000;
        proxy_pass $grafana_upstream;
    }

    location /_next/static/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://leadex_web;
        expires 365d;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        limit_req zone=general burst=100 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://leadex_web;
    }
}
